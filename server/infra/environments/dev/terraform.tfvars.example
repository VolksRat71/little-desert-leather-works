aws_region       = "us-east-1"
environment      = "dev"
project_name     = "little-desert-leather-works"

# VPC Settings
vpc_cidr          = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# Database Settings
database_name            = "little_desert_leather_works_dev"
database_username        = "postgres"
database_password        = "ChangeMe123!"  # Change this in the actual tfvars file
database_port            = 5432
db_instance_class        = "db.t3.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 100
